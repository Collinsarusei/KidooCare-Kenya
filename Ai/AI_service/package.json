{
  "name": "kiddocare-ai-service",
  "version": "2.0.0",
  "description": "Genkit AI service for KiddoCare Daycare Marketplace Platform",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "npm run build && firebase deploy --only functions",
    "logs": "firebase functions:log",
    "genkit:dev": "genkit start -- tsx --watch src/index.ts",
    "genkit:flow": "genkit flow:run draftDaycareProfile",
    "genkit:deploy": "genkit deploy",
    "genkit:lint": "genkit lint",
    "genkit:test": "genkit test",

    
    "dev:server": "tsx watch src/server.ts",
    "start:server": "tsx src/server.ts",
    "ai:start": "tsx src/server.ts",
    "ai:dev": "tsx watch src/server.ts",
    "dev": "tsx watch src/server.ts"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@genkit-ai/core": "^1.1.0",
    "@genkit-ai/firebase": "^1.21.0",
    "@genkit-ai/googleai": "^1.21.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",          
    "cors": "^2.8.5",              
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^5.1.1",
    "genkit": "^1.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/express": "^4.17.21",  
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "genkit-cli": "^1.21.0"
  },
  "private": true
}
